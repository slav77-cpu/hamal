---
// Страница за всяка услуга от services.ts: H1 „[Услуга] в [град]“, цена „от“, какво е включено,
// снимки, въпроси и бутони за контакт.
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CallToAction from '../../components/CallToAction.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import Faq from '../../components/Faq.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { pricing } from '../../data/pricing';
import { services, type Service } from '../../data/services';
import { site } from '../../data/site';
import { formatPriceFrom, inCity } from '../../lib/format';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const city = inCity(site.city);
const price = formatPriceFrom(pricing.servicesFrom[service.slug]);
const priceText = service.priceUnit ? `${price} ${service.priceUnit}` : price;
const [mainPhoto, ...morePhotos] = service.photos;
const others = services.filter((s) => s.slug !== service.slug);
---

<Base
  title={`${service.title} ${city} — ${priceText} | ${site.name}`}
  description={`${service.title} ${city}, ${priceText}. ${service.short}`}
>
  <PageHeader
    title={`${service.title} ${city}`}
    intro={service.intro}
    crumbs={[{ href: '/uslugi', label: 'Услуги' }]}
    current={service.title}
  >
    <p class="mt-6 inline-flex items-baseline gap-2 rounded-xl bg-brand/30 px-4 py-2">
      <span class="text-2xl font-bold">{price}</span>
      {service.priceUnit && <span class="text-muted">{service.priceUnit}</span>}
    </p>
    <ContactButtons channels={['call', 'viber']} class="mt-6 max-w-md" />
    {
      mainPhoto && (
        <Picture
          slot="aside"
          src={mainPhoto.src}
          alt={mainPhoto.alt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-4/3 w-full rounded-2xl object-cover"
        />
      )
    }
  </PageHeader>

  <Section id="vklyucheno" title="Какво е включено">
    <div class="grid gap-8 md:grid-cols-2">
      <ul class="space-y-3">
        {
          service.included.map((item) => (
            <li class="flex items-start gap-3 text-lg">
              <Icon name="check" class="mt-1 size-5 shrink-0 text-whatsapp" />
              {item}
            </li>
          ))
        }
      </ul>
      <div class="rounded-2xl bg-surface p-6">
        <p class="text-lg font-semibold">Колко ще струва точно?</p>
        <p class="mt-2 text-muted">
          Зависи от багажа, етажите и разстоянието. Изчислете ориентировъчна цена или пратете снимки за точна.
        </p>
        <a
          href="/ceni#kalkulator"
          class="mt-5 inline-flex min-h-12 items-center gap-2 rounded-xl bg-ink px-5 font-semibold text-white hover:bg-slate-800"
        >
          <Icon name="calculator" class="size-5" />
          Изчисли цена
        </a>
        <p class="mt-3 text-sm text-muted">{site.vatNote}</p>
      </div>
    </div>
  </Section>

  {
    morePhotos.length > 0 && (
      <Section id="snimki" title="Снимки" tone="surface">
        <Gallery photos={morePhotos} />
      </Section>
    )
  }

  <Section id="vaprosi" title="Въпроси и отговори">
    <div class="max-w-3xl">
      <Faq items={service.faq} />
    </div>
  </Section>

  <Section id="drugi-uslugi" title="Други услуги" tone="surface">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        others.map((other) => (
          <li>
            <ServiceCard service={other} />
          </li>
        ))
      }
    </ul>
  </Section>

  <CallToAction />
</Base>
