---
// Страница за всяка услуга от services.ts: H1 „[Услуга] в [град]“, цена „от“, какво е включено,
// снимки, въпроси и бутони за контакт.
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CallToAction from '../../components/CallToAction.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import Faq from '../../components/Faq.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { pricing } from '../../data/pricing';
import { services, type Service } from '../../data/services';
import { site } from '../../data/site';
import { formatPriceFrom, inCity } from '../../lib/format';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const city = inCity(site.city);
const price = formatPriceFrom(pricing.servicesFrom[service.slug]);
const priceText = service.priceUnit ? `${price} ${service.priceUnit}` : price;
const [mainPhoto, ...morePhotos] = service.photos;
const others = services.filter((s) => s.slug !== service.slug);
---

<Base
  title={`${service.title} ${city} — ${priceText} | ${site.name}`}
  description={`${service.title} ${city}, ${priceText}. ${service.short}`}
  image={mainPhoto?.src}
>
  <PageHeader
    title={`${service.title} ${city}`}
    intro={service.intro}
    crumbs={[{ href: '/uslugi', label: 'Услуги' }]}
    current={service.title}
  >
    <p class="mt-6 flex items-baseline gap-2">
      <span class="font-display text-[44px] leading-none font-black text-accent">{price}</span>
      {service.priceUnit && <span class="font-semibold text-white/70">{service.priceUnit}</span>}
    </p>
    <ContactButtons channels={['call', 'viber']} tone="dark" class="mt-7 max-w-md" />
    {
      mainPhoto && (
        <Picture
          slot="aside"
          src={mainPhoto.src}
          alt={mainPhoto.alt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-4/3 w-full rounded-3xl object-cover"
        />
      )
    }
  </PageHeader>

  <Section id="vklyucheno" eyebrow={service.title} title="Какво е включено">
    <div class="grid gap-8 md:grid-cols-2">
      <ul class="flex flex-col gap-3">
        {
          service.included.map((item) => (
            <li class="flex items-start gap-3 text-lg">
              <Icon name="check" class="mt-1 size-5 shrink-0 text-accent-ink" />
              {item}
            </li>
          ))
        }
      </ul>
      <div class="flex flex-col gap-3 rounded-[20px] border border-line bg-ground p-7">
        <p class="font-display text-[28px] leading-[1.1] font-extrabold">Колко ще струва точно?</p>
        <p class="text-muted">
          Зависи от багажа, етажите и разстоянието. Изчислете ориентировъчна цена или пратете снимки за точна.
        </p>
        <a href="/ceni#kalkulator" class="btn btn-secondary mt-2 self-start">
          <Icon name="calculator" class="size-5" />
          Изчисли цена
        </a>
        <p class="text-sm text-muted">{site.vatNote}</p>
      </div>
    </div>
  </Section>

  {
    morePhotos.length > 0 && (
      <Section id="snimki" eyebrow="Снимки" title="Снимки от обекти" tone="ground">
        <Gallery photos={morePhotos} />
      </Section>
    )
  }

  <Section id="vaprosi" eyebrow="Въпроси" title="Въпроси и отговори">
    <div class="max-w-3xl">
      <Faq items={service.faq} name={`faq-${service.slug}`} />
    </div>
  </Section>

  <Section id="drugi-uslugi" eyebrow="Още услуги" title="Други услуги" tone="ground">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        others.map((other) => (
          <li>
            <ServiceCard service={other} index={services.indexOf(other) + 1} />
          </li>
        ))
      }
    </ul>
  </Section>

  <CallToAction />
</Base>
