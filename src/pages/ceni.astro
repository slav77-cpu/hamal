---
// Цени: ценоразпис, пакети, калкулатор и под него формата за запитване.
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import Packages from '../components/Packages.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm';
import PriceTable from '../components/PriceTable.astro';
import Section from '../components/Section.astro';
import { pricing } from '../data/pricing';
import { site } from '../data/site';
import { formatPriceFrom, inCity } from '../lib/format';

const city = inCity(site.city);
const hourly = `${formatPriceFrom(pricing.porterPerHour)}/час`;
---

<Base
  title={`Цени за хамалски услуги ${city} — ${hourly} | ${site.name}`}
  description={`Цени за хамалски услуги ${city}: хамалин ${hourly}, бус с шофьор, пакети за гарсониера, двустаен и тристаен. Калкулатор за ориентировъчна цена.`}
>
  <PageHeader
    title={`Цени за хамалски услуги ${city}`}
    intro="Всички цени са в евро. Изчислете ориентировъчна цена с калкулатора или се обадете за точна."
    current="Цени"
  >
    <div class="mt-7 flex flex-wrap gap-3">
      <a href="#kalkulator" class="btn btn-primary">
        <Icon name="calculator" class="size-5" />
        Изчисли цена
      </a>
      <a href="#cenorazpis" class="btn btn-ghost">Ценоразпис</a>
    </div>
  </PageHeader>

  <Section id="cenorazpis" eyebrow="Цени" title="Ценоразпис" intro="Всички цени са в евро, „от“ — за най-простия случай.">
    <PriceTable />
  </Section>

  <Section
    id="paketi"
    eyebrow="Пакети"
    title="Пакети за преместване"
    intro="Хамали и бус за целия обект. Цената е за партер и в града — етажите без асансьор и километрите се добавят."
    tone="ground"
  >
    <Packages />
  </Section>

  <Section
    id="kalkulator"
    eyebrow="Калкулатор"
    title="Калкулатор за ориентировъчна цена"
    intro="Отговорете на четирите въпроса — цената се смята веднага."
  >
    <Calculator client:visible />
  </Section>

  <CallToAction title="Изпрати запитване" intro="Попълнете формата или се обадете — ще ви кажем точната цена.">
    <QuoteForm client:visible />
  </CallToAction>
</Base>
