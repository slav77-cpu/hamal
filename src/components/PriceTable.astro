---
// Ценоразпис (т. 6) в стила на блока „Допълнително“: редове „Услуга ······ цена“,
// бележка за ДДС и за ориентировъчните цени.
import { site } from '../data/site';
import { priceDisclaimer, priceList } from '../lib/price-list';
---

<div class="rounded-[20px] border border-line bg-ground p-[clamp(22px,3vw,34px)]">
  <dl class="grid gap-x-12 lg:grid-cols-2">
    {
      priceList.map((row) => (
        <div class="leader-row border-b border-line py-3.5" data-price-row>
          <dt class="leader-label font-semibold">{row.label}</dt>
          <dd class="leader-value">
            {row.price}
            {row.unit !== '—' && <small> {row.unit}</small>}
          </dd>
        </div>
      ))
    }
  </dl>
  <p class="mt-5 text-[15px] text-muted">{priceDisclaimer}</p>
  <p class="mt-1 text-[15px] text-muted">{site.vatNote}</p>
</div>
