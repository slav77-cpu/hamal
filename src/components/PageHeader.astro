---
// Горна част на вътрешна страница — тъмна, като началния екран: пътека, H1, увод.
// Слот по подразбиране — под увода (бутони, цена); слот „aside“ — вдясно на компютър (снимка).
interface Crumb {
  href: string;
  label: string;
}

interface Props {
  title: string;
  intro?: string;
  crumbs?: Crumb[]; // без „Начало“ и без текущата страница
  current?: string; // името на текущата страница в пътеката; по подразбиране — title
}

const { title, intro, crumbs = [], current = title } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="bg-ink text-white">
  <div
    class:list={[
      'container-page pt-[clamp(32px,5vw,64px)] pb-[clamp(48px,6vw,80px)]',
      hasAside && 'grid items-center gap-10 md:grid-cols-2 md:gap-14',
    ]}
  >
    <div>
      <nav aria-label="Навигационна пътека">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/70">
          {
            [{ href: '/', label: 'Начало' }, ...crumbs].map((crumb) => (
              <li class="flex items-center gap-2">
                <a href={crumb.href} class="underline-offset-2 hover:underline">
                  {crumb.label}
                </a>
                <span aria-hidden="true">/</span>
              </li>
            ))
          }
          <li aria-current="page" class="font-semibold text-white">{current}</li>
        </ol>
      </nav>
      <h1 class="mt-5 font-display text-[clamp(40px,5vw,64px)] leading-[0.95] font-black tracking-[-0.01em]">
        {title}
      </h1>
      {intro && <p class="mt-5 max-w-[580px] text-[clamp(17px,1.5vw,20px)] leading-relaxed text-white/80">{intro}</p>}
      <slot />
    </div>
    <slot name="aside" />
  </div>
</section>
