---
// Горна част на вътрешна страница: навигационна пътека, H1, увод.
// Слот по подразбиране — под увода (бутони, цена); слот „aside“ — вдясно на компютър (снимка).
interface Crumb {
  href: string;
  label: string;
}

interface Props {
  title: string;
  intro?: string;
  crumbs?: Crumb[]; // без „Начало“ и без текущата страница
  current?: string; // името на текущата страница в пътеката; по подразбиране — title
}

const { title, intro, crumbs = [], current = title } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="border-b border-line bg-surface">
  <div class:list={['container-page py-8 sm:py-12', hasAside && 'grid items-center gap-8 md:grid-cols-2 md:gap-12']}>
    <div>
      <nav aria-label="Навигационна пътека">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
          {
            [{ href: '/', label: 'Начало' }, ...crumbs].map((crumb) => (
              <li class="flex items-center gap-2">
                <a href={crumb.href} class="underline-offset-2 hover:underline">
                  {crumb.label}
                </a>
                <span aria-hidden="true">/</span>
              </li>
            ))
          }
          <li aria-current="page" class="font-medium text-ink">{current}</li>
        </ol>
      </nav>
      <h1 class="mt-4 text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">{title}</h1>
      {intro && <p class="mt-4 max-w-2xl text-lg text-muted">{intro}</p>}
      <slot />
    </div>
    <slot name="aside" />
  </div>
</section>
