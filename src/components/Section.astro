---
// Секция: етикет над заглавието, H2, кратък увод и съдържание (design/DESIGN.md, т. 2, 3, 5).
interface Props {
  id: string;
  title: string;
  intro?: string;
  eyebrow?: string;
  tone?: 'surface' | 'ground' | 'ink';
  afterTape?: boolean; // повече място отгоре, когато лентата „тиксо“ застъпва секцията
}

const { id, title, intro, eyebrow, tone = 'surface', afterTape = false } = Astro.props;
const dark = tone === 'ink';
const bg = { surface: 'bg-surface', ground: 'bg-ground', ink: 'bg-ink text-white' }[tone];
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={[bg, afterTape ? 'pt-[clamp(80px,9vw,112px)] pb-[clamp(64px,8vw,104px)]' : 'section-y']}
>
  <div class="container-page">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
      <div class="flex max-w-[680px] flex-col gap-3.5">
        {eyebrow && <span class:list={['eyebrow', dark && 'eyebrow-dark']}>{eyebrow}</span>}
        <h2 id={`${id}-title`} class="h2-display">{title}</h2>
        {intro && <p class:list={['text-[17px] leading-relaxed', dark ? 'text-white/78' : 'text-muted']}>{intro}</p>}
      </div>
      <slot name="action" />
    </div>
    <slot />
  </div>
</section>
