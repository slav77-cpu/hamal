---
// Строителните услуги от construction.ts: „tiles“ — малки плочки на тъмен фон (начална страница),
// „cards“ — карти с кратко описание (страницата /stroitelni-uslugi). Без цени — оферта на място.
import Icon from './Icon.astro';
import { construction } from '../data/construction';

interface Props {
  variant?: 'tiles' | 'cards';
}

const { variant = 'tiles' } = Astro.props;
---

{
  variant === 'tiles' ? (
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {construction.services.map((service) => (
        <li class="flex items-center gap-3 rounded-2xl border border-white/12 bg-white/[0.06] p-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent text-ink">
            <Icon name={service.icon} class="size-[22px]" />
          </span>
          <span class="leading-tight font-extrabold">{service.title}</span>
        </li>
      ))}
    </ul>
  ) : (
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {construction.services.map((service) => (
        <li class="card card-shadow flex flex-col gap-3 p-[26px]">
          <span class="grid size-14 place-items-center rounded-[14px] bg-tint">
            <Icon name={service.icon} class="size-7" />
          </span>
          <h2 class="h3-display mt-1.5">{service.title}</h2>
          <p class="flex-grow text-base text-muted">{service.text}</p>
          <p class="leader-row border-t border-dashed border-line pt-3.5">
            <span class="leader-label text-sm font-bold text-muted">Цена</span>
            <span class="leader-value text-lg">оферта на място</span>
          </p>
        </li>
      ))}
    </ul>
  )
}
