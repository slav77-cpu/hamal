---
// Карта на услуга (design/DESIGN.md, т. 5): иконка, „№ 01“, заглавие, едно изречение и „Цена ······ от XX €“.
import Icon from './Icon.astro';
import { pricing } from '../data/pricing';
import type { Service } from '../data/services';
import { formatPriceFrom } from '../lib/format';

interface Props {
  service: Service;
  index: number; // 1, 2, 3… → „№ 01“
  headingLevel?: 'h2' | 'h3';
}

const { service, index, headingLevel: Heading = 'h3' } = Astro.props;
const price = formatPriceFrom(pricing.servicesFrom[service.slug]);
---

<a
  href={`/uslugi/${service.slug}`}
  class="card card-hover flex h-full flex-col gap-3.5 p-[26px] text-ink no-underline"
>
  <div class="flex items-center justify-between">
    <span class="grid size-14 place-items-center rounded-[14px] bg-tint">
      <Icon name={service.icon} class="size-7" />
    </span>
    <span class="text-[13px] font-extrabold tracking-[0.12em] text-muted" aria-hidden="true">
      № {String(index).padStart(2, '0')}
    </span>
  </div>
  <Heading class="h3-display mt-1.5">{service.title}</Heading>
  <p class="flex-grow text-base leading-normal text-muted">{service.short}</p>
  <div class="leader-row border-t border-dashed border-line pt-3.5">
    <span class="leader-label text-sm font-bold text-muted">Цена</span>
    <span class="leader-value text-2xl font-black whitespace-nowrap">
      {price}{service.priceUnit && <small> {service.priceUnit}</small>}
    </span>
  </div>
</a>
