---
// Карта на услуга: икона, едно изречение, цена „от“ и линк към страницата ѝ.
import Icon from './Icon.astro';
import { pricing } from '../data/pricing';
import type { Service } from '../data/services';
import { formatPriceFrom } from '../lib/format';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel: Heading = 'h3' } = Astro.props;
const price = formatPriceFrom(pricing.servicesFrom[service.slug]);
---

<a
  href={`/uslugi/${service.slug}`}
  class="group flex h-full flex-col rounded-2xl border border-line bg-white p-5 transition hover:border-slate-400 hover:shadow-md"
>
  <div class="flex items-center gap-3 sm:block">
    <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-brand/30 text-ink">
      <Icon name={service.icon} class="size-6" />
    </span>
    <Heading class="text-lg leading-snug font-semibold sm:mt-4">{service.title}</Heading>
  </div>
  <p class="mt-3 flex-1 text-muted sm:mt-2">{service.short}</p>
  <div class="mt-4 flex items-center justify-between gap-3">
    <p>
      <span class="text-lg font-bold">{price}</span>
      {service.priceUnit && <span class="text-muted"> {service.priceUnit}</span>}
    </p>
    <span class="flex items-center gap-1 text-sm font-semibold">
      Виж повече
      <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</a>
