---
// Пакети (т. 6). Цената „от“ е долната граница на калкулатора за партер, в града, без допълнителни.
import { site } from '../data/site';
import { packages, priceDisclaimer } from '../lib/price-list';
---

<div>
  <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {
      packages.map((pkg) => (
        <li class="flex flex-col rounded-2xl border border-line bg-white p-5">
          <h3 class="text-lg font-semibold">{pkg.label}</h3>
          <p class="mt-1 flex-1 text-sm text-muted">{pkg.includes}</p>
          <p class="mt-4 text-xl font-bold">{pkg.price}</p>
        </li>
      ))
    }
  </ul>
  <p class="mt-4 text-muted">{priceDisclaimer}</p>
  <p class="mt-1 text-muted">{site.vatNote}</p>
</div>
