---
// Бутони „Обади се“ / Viber / WhatsApp с номера като текст и подкана за снимки.
// Viber работи само с инсталирано приложение, затова номерът винаги се вижда.
import Icon, { type IconName } from './Icon.astro';
import { contact } from '../lib/links';

type Channel = 'call' | 'viber' | 'whatsapp';

interface Props {
  channels?: Channel[];
  showPhone?: boolean;
  photosNote?: boolean;
  tone?: 'light' | 'dark';
  class?: string;
}

const {
  channels = ['call', 'viber', 'whatsapp'],
  showPhone = true,
  photosNote = true,
  tone = 'light',
  class: className,
} = Astro.props;

const dark = tone === 'dark';
const secondary = dark ? 'btn-ghost' : 'btn-outline';

const buttons: Record<Channel, { href: string; label: string; icon: IconName; event: string; class: string }> = {
  call: { href: contact.tel, label: 'Обади се', icon: 'phone', event: 'call_click', class: 'btn-primary' },
  viber: { href: contact.viber, label: 'Viber', icon: 'viber', event: 'viber_click', class: secondary },
  whatsapp: { href: contact.whatsapp, label: 'WhatsApp', icon: 'whatsapp', event: 'whatsapp_click', class: secondary },
};

// При три бутона „Обади се“ е на цял ред, а Viber и WhatsApp — под него
const callFullRow = channels.length > 2;
const muted = dark ? 'text-white/78' : 'text-muted';
const strong = dark ? 'text-white' : 'text-ink';
---

<div class={className}>
  <div class="flex flex-wrap gap-3">
    {
      channels.map((channel) => {
        const b = buttons[channel];
        return (
          <a
            href={b.href}
            class:list={['btn flex-1 basis-36', b.class, channel === 'call' && callFullRow && 'basis-full']}
            data-umami-event={b.event}
          >
            <Icon name={b.icon} class="size-5" />
            {b.label}
          </a>
        );
      })
    }
  </div>
  {
    showPhone && (
      <p class:list={['mt-4', muted]}>
        Телефон:{' '}
        <a href={contact.tel} class:list={['text-lg font-extrabold underline', strong]} data-umami-event="call_click">
          {contact.phoneText}
        </a>
      </p>
    )
  }
  {
    photosNote && (
      <p class:list={['mt-2 flex items-center gap-2 text-[15px]', muted]}>
        <Icon name="camera" class="size-5 shrink-0" />
        Пратете снимки на багажа за точна цена
      </p>
    )
  }
</div>
