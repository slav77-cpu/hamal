---
// Горна лента (design/DESIGN.md, т. 6.1): тъмна, лепкава, 76px. Меню над 900px; под 640px телефонът е само иконка.
import Icon from './Icon.astro';
import { site } from '../data/site';
import { inCity } from '../lib/format';
import { contact } from '../lib/links';
import { mainLinks, serviceLinks } from '../lib/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
const inServices = path === '/uslugi' || path.startsWith('/uslugi/');
const inSection = (href: string) => path === href || path.startsWith(`${href}/`);
const navLink = 'rounded-lg px-3 py-2 underline-offset-[10px] hover:text-white hover:underline';
const active = 'text-white underline decoration-accent decoration-2';
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-ink text-white">
  <div class="container-page flex h-[76px] items-center gap-4">
    <a href="/" class="flex min-w-0 items-center gap-3">
      <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent text-ink">
        <Icon name="package" class="size-6" />
      </span>
      <span class="flex min-w-0 flex-col gap-1 leading-none">
        <span class="truncate font-display text-[22px] font-black tracking-[0.03em] uppercase">{site.name}</span>
        <span class="truncate text-[13px] font-medium text-white/70">Хамалски услуги {inCity(site.city)}</span>
      </span>
    </a>

    <nav
      class="ml-auto hidden items-center gap-2 text-base font-semibold text-white/85 min-[900px]:flex"
      aria-label="Основно меню"
    >
      <div class="relative" data-dropdown>
        <button
          type="button"
          class:list={['group flex items-center gap-1', navLink, inServices && active]}
          aria-expanded="false"
          aria-controls="services-menu"
          data-toggle
        >
          Услуги
          <Icon name="chevron-down" class="size-4 transition-transform group-aria-expanded:rotate-180" />
        </button>
        <div
          id="services-menu"
          class="card card-shadow absolute top-full left-0 mt-3 w-80 p-2 text-ink"
          hidden
        >
          <ul>
            {
              serviceLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block rounded-xl px-3 py-2.5 font-semibold hover:bg-ground aria-[current=page]:text-accent-ink"
                    aria-current={current(link.href)}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/uslugi" class="mt-1 block rounded-xl border-t border-line px-3 pt-3 pb-2 text-sm font-extrabold hover:bg-ground">
            Всички услуги →
          </a>
        </div>
      </div>

      {
        mainLinks.map((link) => (
          <a href={link.href} class:list={[navLink, inSection(link.href) && active]} aria-current={current(link.href)}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 min-[900px]:ml-4">
      <a
        href={contact.tel}
        class="btn btn-primary min-h-12 min-w-12 px-3 sm:px-4"
        aria-label={`Обади се: ${contact.phoneText}`}
        data-umami-event="call_click"
      >
        <Icon name="phone" class="size-5" />
        <span class="hidden sm:inline">{contact.phoneText}</span>
      </a>
      <button
        type="button"
        class="group grid size-12 place-items-center rounded-xl border-2 border-white/30 min-[900px]:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Меню"
        data-toggle
      >
        <Icon name="menu" class="size-6 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden size-6 group-aria-expanded:block" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="max-h-[calc(100dvh-76px)] overflow-y-auto border-t border-white/10 min-[900px]:hidden" hidden>
    <nav class="container-page py-4" aria-label="Меню">
      <p class="px-3 text-[13px] font-extrabold tracking-[0.1em] text-white/60 uppercase">Услуги</p>
      <ul class="mt-1">
        {
          serviceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-xl px-3 py-3 text-lg font-semibold aria-[current=page]:text-accent"
                aria-current={current(link.href)}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mt-2 border-t border-white/10 pt-2">
        <li>
          <a href="/uslugi" class="block rounded-xl px-3 py-3 text-lg font-extrabold" aria-current={current('/uslugi')}>
            Всички услуги
          </a>
        </li>
        {
          mainLinks.map((link) => (
            <li>
              <a href={link.href} class="block rounded-xl px-3 py-3 text-lg font-extrabold" aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-2 border-t border-white/10 px-3 pt-4 text-white/70">
        Телефон:{' '}
        <a href={contact.tel} class="font-extrabold text-white underline" data-umami-event="call_click">
          {contact.phoneText}
        </a>
      </p>
    </nav>
  </div>
</header>

<script>
  // Меню „Услуги“ и менюто на телефон: отваря/затваря, Escape и клик извън затварят.
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-toggle]')];

  const panelOf = (button: HTMLButtonElement) =>
    document.getElementById(button.getAttribute('aria-controls') ?? '');

  const setOpen = (button: HTMLButtonElement, open: boolean) => {
    button.setAttribute('aria-expanded', String(open));
    panelOf(button)?.toggleAttribute('hidden', !open);
  };

  for (const button of toggles) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      for (const other of toggles) if (other !== button) setOpen(other, false);
      setOpen(button, open);
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const button of toggles) {
      if (button.getAttribute('aria-expanded') === 'true') {
        setOpen(button, false);
        button.focus();
      }
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    for (const button of toggles) {
      if (button.contains(target) || panelOf(button)?.contains(target)) continue;
      setOpen(button, false);
    }
  });
</script>
