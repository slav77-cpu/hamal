---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { contact } from '../lib/links';
import { mainLinks, serviceLinks } from '../lib/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
const inServices = path === '/uslugi' || path.startsWith('/uslugi/');
const inSection = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="relative z-30 border-b border-line bg-white md:sticky md:top-0">
  <div class="container-page flex h-16 items-center gap-3">
    <a href="/" class="flex min-w-0 items-center gap-2" aria-label={`${site.name} — начало`}>
      <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-brand text-ink">
        <Icon name="truck" class="size-5" />
      </span>
      <span class="truncate text-lg leading-tight font-bold">{site.name}</span>
    </a>

    <nav class="ml-4 hidden items-center gap-1 md:flex lg:ml-8" aria-label="Основно меню">
      <div class="relative" data-dropdown>
        <button
          type="button"
          class:list={[
            'group flex items-center gap-1 rounded-lg px-3 py-2 font-medium hover:bg-surface',
            inServices && 'text-ink underline decoration-brand decoration-4 underline-offset-8',
          ]}
          aria-expanded="false"
          aria-controls="services-menu"
          data-toggle
        >
          Услуги
          <Icon name="chevron-down" class="size-4 transition-transform group-aria-expanded:rotate-180" />
        </button>
        <div
          id="services-menu"
          class="absolute top-full left-0 mt-2 w-72 rounded-xl border border-line bg-white p-2 shadow-lg"
          hidden
        >
          <ul>
            {
              serviceLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block rounded-lg px-3 py-2 hover:bg-surface aria-[current=page]:font-semibold"
                    aria-current={current(link.href)}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href="/uslugi"
            class="mt-1 block rounded-lg border-t border-line px-3 pt-3 pb-2 text-sm font-semibold hover:bg-surface"
          >
            Всички услуги
          </a>
        </div>
      </div>

      {
        mainLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2 font-medium hover:bg-surface',
              inSection(link.href) && 'underline decoration-brand decoration-4 underline-offset-8',
            ]}
            aria-current={current(link.href)}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <a
        href={contact.tel}
        class="flex h-11 items-center gap-2 rounded-xl bg-brand px-4 font-semibold text-ink hover:bg-brand-hover"
        data-umami-event="call_click"
      >
        <Icon name="phone" class="size-5" />
        <span class="md:hidden">Обади се</span>
        <span class="hidden md:inline">{contact.phoneText}</span>
      </a>
      <button
        type="button"
        class="group grid size-11 place-items-center rounded-xl border border-line md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Меню"
        data-toggle
      >
        <Icon name="menu" class="size-6 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden size-6 group-aria-expanded:block" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="border-t border-line bg-white md:hidden" hidden>
    <nav class="container-page py-4" aria-label="Меню">
      <p class="px-3 text-sm font-semibold text-muted">Услуги</p>
      <ul class="mt-1">
        {
          serviceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-lg px-3 py-3 text-lg aria-[current=page]:font-semibold"
                aria-current={current(link.href)}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mt-2 border-t border-line pt-2">
        <li>
          <a href="/uslugi" class="block rounded-lg px-3 py-3 text-lg font-semibold" aria-current={current('/uslugi')}>
            Всички услуги
          </a>
        </li>
        {
          mainLinks.map((link) => (
            <li>
              <a href={link.href} class="block rounded-lg px-3 py-3 text-lg font-semibold" aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-2 border-t border-line px-3 pt-4 text-muted">
        Телефон:{' '}
        <a href={contact.tel} class="font-semibold text-ink underline" data-umami-event="call_click">
          {contact.phoneText}
        </a>
      </p>
    </nav>
  </div>
</header>

<script>
  // Меню „Услуги“ и менюто на телефон: отваря/затваря, Escape и клик извън затварят.
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-toggle]')];

  const panelOf = (button: HTMLButtonElement) =>
    document.getElementById(button.getAttribute('aria-controls') ?? '');

  const setOpen = (button: HTMLButtonElement, open: boolean) => {
    button.setAttribute('aria-expanded', String(open));
    panelOf(button)?.toggleAttribute('hidden', !open);
  };

  for (const button of toggles) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      for (const other of toggles) if (other !== button) setOpen(other, false);
      setOpen(button, open);
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const button of toggles) {
      if (button.getAttribute('aria-expanded') === 'true') {
        setOpen(button, false);
        button.focus();
      }
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    for (const button of toggles) {
      if (button.contains(target) || panelOf(button)?.contains(target)) continue;
      setOpen(button, false);
    }
  });
</script>
