---
// Иконите се вграждат като SVG при build — без JavaScript и без външни заявки.
// Общите са от Lucide, логата на Viber и WhatsApp — от Simple Icons.
import { siViber, siWhatsapp } from 'simple-icons';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import Building from '@lucide/astro/icons/building';
import Calculator from '@lucide/astro/icons/calculator';
import Camera from '@lucide/astro/icons/camera';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Clock from '@lucide/astro/icons/clock';
import House from '@lucide/astro/icons/house';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Package from '@lucide/astro/icons/package';
import Menu from '@lucide/astro/icons/menu';
import Phone from '@lucide/astro/icons/phone';
import Star from '@lucide/astro/icons/star';
import Trash from '@lucide/astro/icons/trash';
import Truck from '@lucide/astro/icons/truck';
import User from '@lucide/astro/icons/user';
import Users from '@lucide/astro/icons/users';
import Wrench from '@lucide/astro/icons/wrench';
import X from '@lucide/astro/icons/x';

const lucide = {
  'arrow-right': ArrowRight,
  'arrow-up': ArrowUp,
  'badge-check': BadgeCheck,
  building: Building,
  calculator: Calculator,
  camera: Camera,
  check: Check,
  'chevron-down': ChevronDown,
  clock: Clock,
  house: House,
  mail: Mail,
  'map-pin': MapPin,
  package: Package,
  menu: Menu,
  phone: Phone,
  star: Star,
  trash: Trash,
  truck: Truck,
  user: User,
  users: Users,
  wrench: Wrench,
  close: X,
};

const brands = { viber: siViber.path, whatsapp: siWhatsapp.path };

export type IconName = keyof typeof lucide | keyof typeof brands;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
const LucideIcon = name in lucide ? lucide[name as keyof typeof lucide] : null;
const brandPath = name in brands ? brands[name as keyof typeof brands] : null;
---

{LucideIcon && <LucideIcon class={className} aria-hidden="true" />}
{
  brandPath && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={brandPath} />
    </svg>
  )
}
