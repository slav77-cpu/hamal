---
// „Защо нас“ — фактите от site.ts.
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {
    site.whyUs.map((fact) => (
      <li class="flex gap-4 sm:block">
        <Icon name="badge-check" class:list={['size-8 shrink-0', tone === 'dark' ? 'text-brand' : 'text-ink']} />
        <div>
          <h3 class="text-lg font-semibold sm:mt-3">{fact.title}</h3>
          <p class:list={['mt-1', tone === 'dark' ? 'text-slate-300' : 'text-muted']}>{fact.text}</p>
        </div>
      </li>
    ))
  }
</ul>
