---
// „Защо нас“ — фактите от site.ts, като малки карти.
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {
    site.whyUs.map((fact) => (
      <li class="card flex gap-4 p-6 sm:flex-col">
        <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-tint text-accent-ink">
          <Icon name="badge-check" class="size-6" />
        </span>
        <div>
          <h3 class="text-[21px] leading-tight font-extrabold">{fact.title}</h3>
          <p class="mt-1.5 text-base text-muted">{fact.text}</p>
        </div>
      </li>
    ))
  }
</ul>
