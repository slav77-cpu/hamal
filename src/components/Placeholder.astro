---
// Временно място за част от следващ етап (калкулатор, форма). Изчезва, когато частта е готова.
interface Props {
  text: string;
  tone?: 'light' | 'dark';
}

const { text, tone = 'light' } = Astro.props;
---

<div
  class:list={[
    'grid min-h-48 place-items-center rounded-2xl border-2 border-dashed p-6 text-center',
    tone === 'dark' ? 'border-white/25 text-slate-300' : 'border-slate-300 text-muted',
  ]}
>
  {text}
</div>
