# Копирайте този файл като .env и попълнете стойностите. В Render: Settings → Environment.
# Стойностите се вграждат при build — след промяна в Render е нужен нов deploy.

# Ключ от https://web3forms.com — запитванията отиват на имейла, с който е създаден ключът
PUBLIC_WEB3FORMS_KEY=

# Umami (статистика без бисквитки): Website ID от https://cloud.umami.is → Settings → Websites
PUBLIC_UMAMI_WEBSITE_ID=
# Само ако Umami не е в Umami Cloud — адресът на script.js
PUBLIC_UMAMI_SRC=
